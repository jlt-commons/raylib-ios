#!/usr/bin/env bb
;; tools/extract-from-notebooks SRC-REPO [DEST]
;;
;; One-shot provenance tool. Pulls the tangled sources out of the
;; glimmer-ios-demo notebooks (org-mode literate files) into plain .clj/.cljc
;; files, so this project can be built and read WITHOUT org tangling. After the
;; first run the extracted files are this repo's source of truth and this
;; script is history, not a build step -- rerunning it would clobber local
;; edits, so it refuses to overwrite a file whose content has diverged unless
;; FORCE=1.
;;
;; Blocks marked `:tangle no` are skipped: in the notebooks those are
;; superseded spikes kept for the record. `:comments link` is IGNORED rather
;; than honoured -- it makes org write a breadcrumb comment naming the source
;; org file and line, which is exactly the coupling this extraction removes,
;; and which would break the byte-identity check below.
;;
;; Identity matters for the six pure namespaces, which come from
;; jasalt/jolt-android-experiment at 6d2b291. Both notebooks record their
;; sha256 to prove it. The table in tools/jasalt-identity.edn holds those hashes
;; and the names the files have in this repo, and is the same table the
;; identity test reads (net.b12n.raylib-ios.jasalt-identity-test). --verify
;; below applies it to the files in the tree.
;;
;; Two things changed since the notebooks, and neither is the extraction's
;; fault. The files were renamed into net.b12n.raylib-ios.*, and five of them
;; went through clojure-lsp format, which only moves whitespace. So the check
;; here puts the upstream names back, drops whitespace, and compares with the
;; table's :sha. A fresh extraction writes raw upstream bytes at the paths the
;; notebooks give, which this tree no longer uses: check those against the
;; table's :notebook-sha, then move them to :file by hand.
(require '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[clojure.string :as str])

(def identity-table
  "The six pure namespaces: see tools/jasalt-identity.edn."
  (edn/read-string (slurp (str (fs/path (fs/parent (fs/real-path *file*)) "jasalt-identity.edn")))))

(defn sha256-of [^String s]
  (let [d (java.security.MessageDigest/getInstance "SHA-256")]
    (->> (.digest d (.getBytes s "UTF-8"))
         (map #(format "%02x" %))
         (apply str))))

(defn blocks
  "Every #+begin_src block in `org` carrying a :tangle path, as
  {:path <relative to the org's own directory> :body <string>}."
  [org]
  (let [lines (str/split-lines (slurp (str org)))]
    (loop [[l & more] lines, target nil, acc [], out []]
      (cond
        (nil? l) out
        target   (if (str/starts-with? (str/trim l) "#+end_src")
                   (recur more nil [] (conj out {:path target :body (str (str/join "\n" acc) "\n")}))
                   (recur more target (conj acc l) out))
        (str/starts-with? (str/trim l) "#+begin_src")
        (let [t (second (re-find #":tangle\s+(\S+)" l))]
          (if (and t (not= t "no"))
            (recur more t [] out)
            ;; :tangle no, or no :tangle at all -- skip to the matching end
            (recur (drop-while #(not (str/starts-with? (str/trim %) "#+end_src")) more) nil [] out)))
        :else (recur more nil [] out)))))

(let [[src dest] *command-line-args*
      src   (or src (str (fs/expand-home "~/dev/github--statonjr--glimmer-ios-demo")))
      ;; this repo, found from the script rather than named: the tree moved
      ;; once already (to ~/dev/jlt-commons/raylib-ios) and a hardcoded path
      ;; would have quietly written the extraction back to the old location
      dest  (or dest (str (fs/parent (fs/parent (fs/parent (fs/real-path *file*))))))
      force (= "1" (System/getenv "FORCE"))
      orgs  ["examples/flappy/README.org" "examples/gallery/README.org"]]
  (doseq [org orgs
          {:keys [path body]} (blocks (fs/path src org))
          ;; the C probe and the shell scripts are milestone scaffolding this
          ;; project replaces with tools/ios; only Clojure sources come across
          :when (re-find #"\.cljc?$" path)]
    (let [abs (fs/normalize (fs/path (fs/parent (fs/path src org)) path))
          out (fs/path dest (str (fs/relativize (fs/path src) abs)))]
      (fs/create-dirs (fs/parent out))
      (if (and (fs/exists? out) (not= body (slurp (str out))) (not force))
        (println "SKIP (diverged, FORCE=1 to overwrite):" (str out))
        (do (spit (str out) body)
            (println "wrote" (str (fs/relativize (fs/path dest) out)))))))
  (println)
  (println "identity of the pure namespaces (jasalt/jolt-android-experiment @ 6d2b291),")
  (println "upstream names put back and whitespace dropped, against the table's :sha:")
  (doseq [{:keys [file sha ns]} (sort-by :file identity-table)]
    (let [f (fs/path dest file)]
      (if-not (fs/exists? f)
        (println "  MISSING" file)
        (let [text (reduce (fn [acc [ours theirs]]
                             (str/replace acc
                                          (re-pattern (str "(?<![\\w.-])" (java.util.regex.Pattern/quote (str ours)) "(?![\\w.-])"))
                                          (java.util.regex.Matcher/quoteReplacement (str theirs))))
                           (slurp (str f)) ns)
              got  (sha256-of (str/replace text #"\s+" ""))]
          (println (format "  %-52s %s  %s" file (if (= got sha) "ok" "MISMATCH") (subs got 0 16))))))))
