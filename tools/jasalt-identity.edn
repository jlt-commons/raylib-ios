;; The three namespaces carried from jasalt/jolt-android-experiment at 6d2b291.
;;
;; :file       where this repo keeps it.
;; :upstream   the path it has upstream.
;; :ns         each namespace name used here -> the name upstream has.
;; :notebook-sha  what the glimmer-ios-demo notebooks recorded for the upstream
;;             bytes: the full sha256, or its first 16 hex digits where the
;;             notebooks kept only a prefix.
;; :sha        sha256 of the upstream file at 5b14eb3, the first commit that
;;             carried it, after jasalt-identity/normalise (tools/jasalt_identity.clj):
;;             runs of whitespace become one space and the spaces beside a
;;             bracket go. At 5b14eb3 :notebook-sha matches the raw bytes. All
;;             three have been through clojure-lsp format since (4c23d11),
;;             which only moves layout, so the raw hash no longer matches them
;;             and this one does. A changed string or a merged token still
;;             changes it.
;;
;; The identity test puts the upstream names back into :file, normalises and
;; compares with :sha. tools/extract-from-notebooks reads this
;; too. A fresh extraction is raw upstream bytes, so it is checked against
;; :notebook-sha instead.
[{:file     "src/net/b12n/raylib_ios/gallery/core.cljc"
  :upstream "src/poc/raylib/gallery.cljc"
  :notebook-sha "6bfc1f12cb425b9b"
  :sha      "887e96fd6a37c605abbabbfeeece9742d1bcccbe7d37ccb2ef99802ec6319dba"
  :ns       {net.b12n.raylib-ios.gallery.core poc.raylib.gallery}}
 {:file     "src/net/b12n/raylib_ios/gallery/ui.cljc"
  :upstream "src/poc/raylib/gallery_ui.cljc"
  :notebook-sha "a2301b268d555504"
  :sha      "402ba8191b64a4269ba488849bee2a78f882b5d0f16e098696674bf9c4554a4e"
  :ns       {net.b12n.raylib-ios.gallery.ui poc.raylib.gallery-ui}}
 {:file     "src/net/b12n/raylib_ios/gallery/diagnostics.cljc"
  :upstream "src/poc/raylib/diagnostics.cljc"
  :notebook-sha "179b24736879fdf1"
  :sha      "df069721010857224f499baac1b19374b1f7e8f68cf4b8f22a0b5d31028eb6e7"
  :ns       {net.b12n.raylib-ios.gallery.diagnostics poc.raylib.diagnostics}}]
